TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DATABASE_PATH=/data/link_reader.db

# LLM provider configuration
LLM_PROVIDER=openai_compatible
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_API_KEY=
# When LLM_BASE_URL points to OpenRouter, OPENROUTER_API_KEY is preferred.
OPENROUTER_API_KEY=
LLM_BASE_URL=

# Optional hosted transcript provider (recommended for cloud servers blocked by YouTube)
SUPADATA_API_KEY=
SUPADATA_MODE=native

# Speech-to-text fallback
ASR_MODE=local
WHISPER_MODEL=small
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY_FILE=
MAX_VIDEO_MINUTES=360

# Output language for summaries, answers, and full translation.
# Examples: English, Hebrew, Spanish, Arabic, French, German, Japanese.
TARGET_LANGUAGE=Hebrew
# Optional private-file transcription (preferred over local Whisper when set)
OPENAI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional; auto-generated locally when absent. Protects the setup page.
WHATSAPP_ADMIN_TOKEN=
# Comma-separated E.164 numbers, digits only or with +. Empty = deny all.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_GRAPH_VERSION=v26.0
